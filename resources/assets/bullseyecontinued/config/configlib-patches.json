{
  "version": 5,
  "patches": {
    "string": {
      "game:itemtypes/bullseyecontinued/spear.json": {
        "attributes/ThrowAttack/Aiming/CursorType": "spears_aiming_cursor_type",
        "behaviors/1/properties/stats/HitSound": "(arrow_ping_sound_on_hit) ? value : empty_string"
      },
      "game:itemtypes/bullseyecontinued/arrow.json": {
        "behaviors/0/properties/stats/HitSound": "(arrow_ping_sound_on_hit) ? value : empty_string"
      }
    },
    "number": {
      "bullseyecontinued:entities/spear.json": {
        "client/behaviors/0/airDragFactor": "value / spears_thrown_distance",
        "client/behaviors/0/gravityFactor": "value / spears_thrown_distance",
        "server/behaviors/0/airDragFactor": "value / spears_thrown_distance",
        "server/behaviors/0/gravityFactor": "value / spears_thrown_distance"
      },
      "game:itemtypes/bullseyecontinued/bow.json": {
        "attributes/AimingByType/@@*/AimDifficulty": "bow_aiming_difficulty",
        "attributes/ArrowDamageMultiplierByType/@@*": "value * bows_damage_multiplier"
      },
      "bullseyecontinued:patches/weapons/spear.json": {
        "1/value/Aiming/AimDifficulty": "spears_aiming_difficulty",
        "3/value/properties/stats/DamageStatsByType/@@*/Damage": "value * spears_range_damage_multiplier"
      },
      "bullseyecontinued:patches/tools/pickaxe.json": {
        "0/value/AnimationSpeedBonusFromMiningSpeed": "tool_animation_speed_bonus"
      }
    },
    "boolean": {
      "game:itemtypes/bullseyecontinued/bow.json": {
        "attributes/TwoHanded": "bow_two_handed"
      },
      "bullseyecontinued:patches/weapons/spear.json": {
        "-/enabled": "spears_enabled"
      },
      "bullseyecontinued:patches/weapons/spear-types.json": {
        "-/enabled": "spear_types_enabled"
      }
    }
  },
  "constants": {
    "empty_string": "",
    "vanilla_axe": "ItemAxe",
    "vanilla_item": "Item"
  },
  "settings": [
    {
      "type": "separator",
      "title": "bullseyecontinued:setting-separator-bows"
    },
    {
      "code": "bow_aiming_difficulty",
      "type": "float",
      "ingui": "bullseyecontinued:setting-bow_aiming_difficulty",
      "default": 1.0,
      "range": {
        "min": 0.0,
        "max": 2.0
      }
    },
    {
      "code": "bow_two_handed",
      "type": "boolean",
      "ingui": "bullseyecontinued:setting-bow_two_handed",
      "default": true
    },
    {
      "code": "bows_aiming_cursor_type",
      "type": "string",
      "ingui": "bullseyecontinued:setting-bows_aiming_cursor_type",
      "comment": "bullseyecontinued:setting-comment-bows_aiming_cursor_type",
      "clientSide": true,
      "default": "Moving",
      "values": [
        "None",
        "Vanilla",
        "Fixed",
        "Moving"
      ]
    },
    {
      "code": "bow_aiming_vertical_limit",
      "type": "float",
      "ingui": "bullseyecontinued:setting-bow_aiming_vertical_limit",
      "comment": "bullseyecontinued:setting-comment-bow_aiming_vertical_limit",
      "clientSide": true,
      "default": 1.0,
      "range": {
        "min": 0.0,
        "max": 2.0
      }
    },
    {
      "code": "bow_aiming_horisontal_limit",
      "type": "float",
      "ingui": "bullseyecontinued:setting-bow_aiming_horisontal_limit",
      "comment": "bullseyecontinued:setting-comment-bow_aiming_horisontal_limit",
      "clientSide": true,
      "default": 1.0,
      "range": {
        "min": 0.0,
        "max": 2.0
      }
    },
    {
      "code": "bows_damage_multiplier",
