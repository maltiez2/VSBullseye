      "ingui": "bullseyecontinued:setting-bows_damage_multiplier",
      "default": 1.0,
      "logarithmic": true,
      "range": {
        "min": 0.2,
        "max": 5.0
      }
    },
    {
      "code": "arrow_ping_sound_on_hit",
      "type": "boolean",
      "ingui": "bullseyecontinued:setting-arrow_ping_sound_on_hit",
      "default": true
    },
    {
      "type": "separator",
      "title": "bullseyecontinued:setting-separator-spears"
